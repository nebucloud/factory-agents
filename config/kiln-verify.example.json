{
  "version": "1",
  "metadata": {
    "purpose": "factory-agents F1 hermetic verify example",
    "adr": "0009",
    "note": "Matches kiln-core Pipeline JSON (KLN-D-02). Agents call kiln; they are not kiln."
  },
  "targets": {
    "unit_tests": {
      "run": {
        "interpreter": "bash",
        "code": "set -euo pipefail\npython -m pytest -q\n"
      },
      "inputs": ["source"],
      "outputs": ["test_report"]
    },
    "lint": {
      "run": {
        "interpreter": "bash",
        "code": "set -euo pipefail\nruff check .\n"
      },
      "requires": ["unit_tests"],
      "inputs": ["source"],
      "outputs": ["lint_report"]
    }
  }
}
